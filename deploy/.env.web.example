# Next.js web environment — copy to .env.web and fill in values

# Public site URL (used for Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://borderless.myowncloud.tech

# API base URL for client-side fetches (proxied through Nginx)
NEXT_PUBLIC_API_URL=/api

# WebSocket server URL
NEXT_PUBLIC_WS_URL=wss://borderless.myowncloud.tech/ws

# Internal API URL for server-side rendering (bypasses Nginx)
INTERNAL_API_URL=http://localhost:8080

# GitHub API token for fetching release data (optional, increases rate limit)
GITHUB_TOKEN=ghp_...

# GitHub repository for releases (defaults match public repo)
GITHUB_OWNER=rythmmcosta
GITHUB_REPO=Borderless
