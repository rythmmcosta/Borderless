# Borderless — stack environment variables
# Copy to .env and fill in ALL required values before running docker compose up

# ─── Required secrets ─────────────────────────────────────────────────────────

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Strong unique password for PostgreSQL
POSTGRES_PASSWORD=

# Strong unique password for Redis
REDIS_PASSWORD=

# ─── Server identity ──────────────────────────────────────────────────────────

# Public URL of the web dashboard (used for CORS and Open Graph)
SITE_URL=https://borderless.myowncloud.tech

# WebSocket URL
WS_URL=wss://borderless.myowncloud.tech/ws

# Allowed CORS origins (comma-separated; first value used for Access-Control-Allow-Origin)
CORS_ORIGINS=https://borderless.myowncloud.tech

# Admin account created on first boot
ADMIN_EMAIL=admin@example.com

# ─── Optional ─────────────────────────────────────────────────────────────────

# GitHub read-only token — increases release API rate limit from 60 → 5000 req/hr
GITHUB_TOKEN=ghp_...
