# Borderless — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.

# ─────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ─────────────────────────────────────────────
#  Database
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/borderless

# ─────────────────────────────────────────────
#  Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://:borderless@localhost:6379
REDIS_PASSWORD=borderless

# ─────────────────────────────────────────────
#  Auth (generate with: openssl rand -hex 32)
# ─────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
JWT_EXPIRY_SECONDS=900
REFRESH_EXPIRY_SECONDS=2592000

# ─────────────────────────────────────────────
#  Admin Bootstrap
#  This email gets role=admin on first login
# ─────────────────────────────────────────────
ADMIN_EMAIL=your@email.com

# ─────────────────────────────────────────────
#  Supabase (optional — for cloud features)
# ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ─────────────────────────────────────────────
#  CORS
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# ─────────────────────────────────────────────
#  TURN/STUN (for WebRTC relay)
# ─────────────────────────────────────────────
TURN_SERVER_URL=turn:localhost:3478
TURN_USERNAME=borderless
TURN_PASSWORD=REPLACE_WITH_TURN_PASSWORD
